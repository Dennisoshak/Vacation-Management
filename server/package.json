{
  "name": "vacation-management-server",
  "version": "1.0.0",
  "description": "Backend API for Vacation Management",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --setupFilesAfterEnv=./__tests__/setup.js",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --setupFilesAfterEnv=./__tests__/setup.js",
    "test:coverage": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --setupFilesAfterEnv=./__tests__/setup.js",
    "migrate:latest": "knex migrate:latest --knexfile src/config/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile src/config/knexfile.js",
    "migrate:make": "knex migrate:make --knexfile src/config/knexfile.js",
    "seed:run": "knex seed:run --knexfile src/config/knexfile.js",
    "seed:make": "knex seed:make --knexfile src/config/knexfile.js"
  },
  "keywords": ["express", "sqlite", "knex"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.3",
    "cors": "^2.8.5",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
